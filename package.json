{
  "name": "licenselens",
  "version": "1.0.0",
  "description": "Catch license conflicts in your dependencies before you ship.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "seed": "node seed/seed.js",
    "seed:fetch": "node seed/fetchSeedData.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "nodemonConfig": {
    "ignore": [
      "public/",
      "seed/"
    ]
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.10"
  },
  "author": "Kaleb Maloof and Vincent Putiri"
}
